
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funções auxiliares de validação
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Regras por Coleção
    
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || hasRole('ADMIN') || hasRole('CHEFE');
    }

    match /protocolos/{protocolId} {
      allow read: if isSignedIn();
      allow write: if hasRole('ADMIN') || hasRole('CHEFE');
    }

    match /ciclos/{cicloId} {
      allow read: if isSignedIn();
      allow write: if hasRole('ADMIN') || hasRole('CHEFE') || hasRole('PERSONAL');
    }

    match /sessoes/{sessaoId} {
      allow read: if isSignedIn() && (isOwner(resource.data.userId) || hasRole('PERSONAL') || hasRole('CHEFE'));
      allow create: if isSignedIn();
    }

    match /avaliacoes/{evalId} {
      allow read: if isSignedIn() && (isOwner(resource.data.studentId) || hasRole('CHEFE'));
      allow write: if hasRole('ADMIN') || hasRole('CHEFE');
    }

    match /agendas/{agendaId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isOwner(resource.data.userId) || hasRole('ADMIN');
    }

    match /mensagens/{msgId} {
      allow read: if isSignedIn() && (isOwner(resource.data.userId) || resource.data.userId == 'PUBLIC');
      allow create: if hasRole('ADMIN') || hasRole('CHEFE') || hasRole('PERSONAL');
      allow update: if isSignedIn() && isOwner(resource.data.userId); // Para marcar como lida
    }

    match /timeline/{entryId} {
      allow read: if isSignedIn() && (isOwner(resource.data.userId) || hasRole('PERSONAL') || hasRole('CHEFE'));
      allow create: if isSignedIn();
      allow update, delete: if false; // Timeline é imutável
    }
    
    match /wellness/{serviceId} {
      allow read: if isSignedIn();
      allow write: if hasRole('ADMIN');
    }
  }
}
