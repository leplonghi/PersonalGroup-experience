rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: Get user data from Firestore
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper: Check roles
    function hasRole(role) {
      return isAuth() && getUserData().role == role;
    }

    function isAdmin() {
      return hasRole('ADMIN');
    }

    function isChefe() {
      return hasRole('CHEFE');
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuth();
      
      // Create: Allow if authenticated (initial registration)
      allow create: if isAuth();
      
      // Delete: Strictly ADMIN
      allow delete: if isAdmin();
      
      // Update: ADMIN can do anything. CHEFE cannot touch 'plan' or 'role'.
      allow update: if isAdmin() 
        || (isChefe() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'role']))
        || (request.auth.uid == userId); // User can update their own profile (rules below can further restrict)
    }

    // Default rules for other collections (Mural, Assessments, Protocols, etc.)
    // For now, allowing all authenticated users to read/write to these
    // but in a real app we'd be more specific.
    match /{document=**} {
      allow read, write: if isAuth();
    }
  }
}
